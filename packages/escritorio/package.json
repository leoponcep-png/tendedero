{
  "name": "@tendedero/escritorio",
  "productName": "Tendedero",
  "version": "0.1.1",
  "private": true,
  "description": "Tendedero, el juego de mesa, como aplicación de escritorio para Windows.",
  "author": "Leo Ponce",
  "main": "src/principal.cjs",
  "scripts": {
    "icono": "electron scripts/generar-icono.cjs",
    "web": "node scripts/construir-web.mjs",
    "start": "electron .",
    "instalador": "npm run web && electron-builder --win nsis --x64 --publish never",
    "publicar": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.leoponcep.tendedero",
    "productName": "Tendedero",
    "copyright": "Leo Ponce",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icono.ico",
      "executableName": "Tendedero"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tendedero",
      "uninstallDisplayName": "Tendedero",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icono.ico",
      "uninstallerIcon": "build/icono.ico",
      "artifactName": "Tendedero-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "leoponcep-png",
        "repo": "tendedero",
        "releaseType": "draft"
      }
    ]
  }
}
